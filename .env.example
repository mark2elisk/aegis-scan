# Copia este archivo como .env y rellena los valores. .env NO se sube al repositorio.

# ClamAV (por defecto apunta al servicio "clamav" de docker-compose)
CLAMD_HOST=clamav
CLAMD_PORT=3310

# Límite de tamaño de subida
MAX_UPLOAD_MB=25

# Explicación de resultados con IA. AI_PROVIDER=none desactiva la IA y usa
# una explicación generada localmente sin llamar a ningún servicio externo.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Orígenes permitidos por CORS, separados por comas. Ponlo al dominio real
# antes de desplegar a producción.
CORS_ORIGINS=http://localhost:3000

# Peticiones a /scan permitidas por IP y por minuto.
RATE_LIMIT_PER_MINUTE=10

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
